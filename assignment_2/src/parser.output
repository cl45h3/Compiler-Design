Grammar

    0 $accept: translation_unit $end

    1 translation_unit: /* empty */
    2                 | translation_unit external_declaration

    3 external_declaration: preprocessor_directive
    4                     | function_definition
    5                     | declaration
    6                     | typedef_declaration
    7                     | class_declaration
    8                     | struct_declaration
    9                     | enum_declaration
   10                     | union_declaration
   11                     | template_declaration
   12                     | error SEMICOLON

   13 preprocessor_directive: PP_INCLUDE HEADER_NAME
   14                       | PP_DEFINE IDENTIFIER constant_expression
   15                       | PP_DEFINE IDENTIFIER

   16 template_declaration: template_head external_declaration

   17 template_head: TEMPLATE LT TYPENAME IDENTIFIER GT
   18              | TEMPLATE LT CLASS IDENTIFIER GT

   19 class_head: CLASS named_identifier

   20 struct_head: STRUCT named_identifier

   21 enum_head: ENUM named_identifier

   22 union_head: UNION named_identifier

   23 class_declaration: class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   24                  | class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE

   25 inheritance_opt: /* empty */
   26                | COLON access_specifier_opt base_class_list

   27 access_specifier_opt: /* empty */
   28                     | access_specifier

   29 access_specifier: PUBLIC
   30                 | PRIVATE
   31                 | PROTECTED

   32 base_class_list: qualified_name
   33                | TYPE_NAME
   34                | base_class_list COMMA access_specifier_opt qualified_name

   35 member_list: /* empty */
   36            | member_list member_declaration

   37 member_declaration: access_specifier COLON
   38                   | function_definition
   39                   | declaration
   40                   | typedef_declaration
   41                   | class_declaration
   42                   | struct_declaration
   43                   | enum_declaration
   44                   | union_declaration
   45                   | constructor_definition
   46                   | error SEMICOLON

   47 constructor_definition: qualified_name LEFT_PAREN parameter_list_opt RIGHT_PAREN compound_statement

   48 struct_declaration: struct_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   49                   | struct_head LEFT_BRACE member_list RIGHT_BRACE

   50 union_declaration: union_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   51                  | union_head LEFT_BRACE member_list RIGHT_BRACE

   52 enum_declaration: enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE SEMICOLON
   53                 | enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE

   54 enumerator_list_opt: /* empty */
   55                    | enumerator_list

   56 enumerator_list: named_identifier
   57                | named_identifier ASSIGN constant_expression
   58                | enumerator_list COMMA named_identifier
   59                | enumerator_list COMMA named_identifier ASSIGN constant_expression

   60 function_definition: declaration_specifiers declarator compound_statement

   61 declaration: declaration_specifiers init_declarator_list SEMICOLON

   62 typedef_declaration: TYPEDEF declaration_specifiers typedef_declarator_list SEMICOLON

   63 typedef_declarator_list: typedef_declarator
   64                        | typedef_declarator_list COMMA typedef_declarator

   65 typedef_declarator: declarator
   66                   | declarator ASSIGN initializer

   67 declaration_specifiers: declaration_prefix_opt type_specifier type_suffixes

   68 declaration_prefix_opt: /* empty */
   69                       | declaration_prefix_opt declaration_prefix

   70 declaration_prefix: type_qualifier
   71                   | storage_class_specifier
   72                   | function_specifier

   73 type_suffixes: /* empty */
   74              | type_suffixes type_suffix

   75 type_suffix: SHORT
   76            | LONG
   77            | LONG_LONG
   78            | SIGNED
   79            | UNSIGNED
   80            | CONST
   81            | VOLATILE

   82 storage_class_specifier: STATIC
   83                        | EXTERN
   84                        | REGISTER
   85                        | FRIEND

   86 function_specifier: INLINE

   87 type_qualifier: CONST
   88               | VOLATILE

   89 type_specifier: VOID
   90               | CHAR
   91               | INT
   92               | FLOAT
   93               | DOUBLE
   94               | BOOL
   95               | AUTO
   96               | SHORT
   97               | LONG
   98               | LONG_LONG
   99               | SIGNED
  100               | UNSIGNED
  101               | TYPE_NAME
  102               | STRUCT named_identifier
  103               | STRUCT TYPE_NAME
  104               | ENUM named_identifier
  105               | ENUM TYPE_NAME
  106               | UNION named_identifier
  107               | UNION TYPE_NAME
  108               | TYPENAME qualified_name

  109 init_declarator_list: init_declarator
  110                     | init_declarator_list COMMA init_declarator

  111 init_declarator: declarator
  112                | declarator ASSIGN initializer

  113 initializer: assignment_expression
  114            | LEFT_BRACE initializer_list_opt RIGHT_BRACE

  115 initializer_list_opt: /* empty */
  116                     | initializer_list

  117 initializer_list: initializer
  118                 | initializer_list COMMA initializer
  119                 | initializer_list COMMA

  120 declarator: pointer_opt reference_opt direct_declarator

  121 reference_opt: /* empty */
  122              | reference

  123 reference: BITAND
  124          | BITAND reference

  125 pointer_opt: /* empty */
  126            | pointer

  127 pointer: STAR pointer_after_star

  128 pointer_after_star: /* empty */
  129                   | pointer
  130                   | type_qualifier_list pointer_after_star

  131 type_qualifier_list: type_qualifier

  132 direct_declarator: qualified_name
  133                  | OPERATOR overload_operator
  134                  | LEFT_PAREN declarator RIGHT_PAREN
  135                  | direct_declarator LEFT_BRACKET constant_expression_opt RIGHT_BRACKET
  136                  | direct_declarator LEFT_PAREN parameter_list_opt RIGHT_PAREN
  137                  | direct_declarator LEFT_PAREN argument_expression_list RIGHT_PAREN

  138 overload_operator: PLUS
  139                  | MINUS
  140                  | STAR
  141                  | SLASH
  142                  | PERCENT
  143                  | ASSIGN
  144                  | EQ
  145                  | LT
  146                  | GT
  147                  | LEFT_BRACKET RIGHT_BRACKET
  148                  | LEFT_PAREN RIGHT_PAREN

  149 constant_expression_opt: /* empty */
  150                        | constant_expression

  151 parameter_list_opt: /* empty */
  152                   | parameter_list

  153 parameter_list: parameter_declaration
  154               | parameter_list COMMA parameter_declaration
  155               | parameter_list COMMA ELLIPSIS
  156               | ELLIPSIS

  157 parameter_declaration: declaration_specifiers declarator
  158                      | declaration_specifiers

  159 compound_statement: LEFT_BRACE block_item_list_opt RIGHT_BRACE
  160                   | LEFT_BRACE error RIGHT_BRACE

  161 block_item_list_opt: /* empty */
  162                    | block_item_list

  163 block_item_list: block_item
  164                | block_item_list block_item

  165 block_item: statement
  166           | declaration
  167           | typedef_declaration

  168 statement: compound_statement
  169          | expression_statement
  170          | selection_statement
  171          | iteration_statement
  172          | jump_statement
  173          | labeled_statement
  174          | error SEMICOLON

  175 expression_statement: expression_opt SEMICOLON

  176 selection_statement: IF LEFT_PAREN expression RIGHT_PAREN statement
  177                    | IF LEFT_PAREN expression RIGHT_PAREN statement ELSE statement
  178                    | SWITCH LEFT_PAREN expression RIGHT_PAREN statement

  179 iteration_statement: WHILE LEFT_PAREN expression RIGHT_PAREN statement
  180                    | UNTIL LEFT_PAREN expression RIGHT_PAREN statement
  181                    | DO statement WHILE LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  182                    | DO statement UNTIL LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  183                    | FOR LEFT_PAREN for_init_opt SEMICOLON expression_opt SEMICOLON expression_opt RIGHT_PAREN statement

  184 for_init_opt: /* empty */
  185             | expression
  186             | declaration_specifiers init_declarator_list

  187 jump_statement: GOTO named_identifier SEMICOLON
  188               | CONTINUE SEMICOLON
  189               | BREAK SEMICOLON
  190               | RETURN expression_opt SEMICOLON

  191 labeled_statement: named_identifier COLON statement
  192                  | CASE constant_expression COLON statement
  193                  | DEFAULT COLON statement

  194 expression_opt: /* empty */
  195               | expression

  196 expression: assignment_expression
  197           | expression COMMA assignment_expression

  198 assignment_expression: conditional_expression
  199                      | unary_expression assignment_operator assignment_expression

  200 assignment_operator: ASSIGN
  201                    | ADD_ASSIGN
  202                    | SUB_ASSIGN
  203                    | MUL_ASSIGN
  204                    | DIV_ASSIGN
  205                    | MOD_ASSIGN
  206                    | AND_ASSIGN
  207                    | OR_ASSIGN
  208                    | XOR_ASSIGN
  209                    | SHL_ASSIGN
  210                    | SHR_ASSIGN

  211 conditional_expression: logical_or_expression
  212                       | logical_or_expression QUESTION_MARK expression COLON conditional_expression

  213 constant_expression: conditional_expression

  214 logical_or_expression: logical_and_expression
  215                      | logical_or_expression OROR logical_and_expression

  216 logical_and_expression: inclusive_or_expression
  217                       | logical_and_expression ANDAND inclusive_or_expression

  218 inclusive_or_expression: exclusive_or_expression
  219                        | inclusive_or_expression BITOR exclusive_or_expression

  220 exclusive_or_expression: and_expression
  221                        | exclusive_or_expression BITXOR and_expression

  222 and_expression: equality_expression
  223               | and_expression BITAND equality_expression

  224 equality_expression: relational_expression
  225                    | equality_expression EQ relational_expression
  226                    | equality_expression NE relational_expression

  227 relational_expression: shift_expression
  228                      | relational_expression LT shift_expression
  229                      | relational_expression GT shift_expression
  230                      | relational_expression LE shift_expression
  231                      | relational_expression GE shift_expression

  232 shift_expression: additive_expression
  233                 | shift_expression SHL additive_expression
  234                 | shift_expression SHR additive_expression

  235 additive_expression: multiplicative_expression
  236                    | additive_expression PLUS multiplicative_expression
  237                    | additive_expression MINUS multiplicative_expression

  238 multiplicative_expression: cast_expression
  239                          | multiplicative_expression STAR cast_expression
  240                          | multiplicative_expression SLASH cast_expression
  241                          | multiplicative_expression PERCENT cast_expression

  242 cast_expression: unary_expression
  243                | LEFT_PAREN type_id RIGHT_PAREN cast_expression

  244 type_id: declaration_specifiers pointer_opt

  245 unary_expression: postfix_expression
  246                 | INC unary_expression
  247                 | DEC unary_expression
  248                 | BITAND cast_expression
  249                 | STAR cast_expression
  250                 | PLUS cast_expression
  251                 | MINUS cast_expression
  252                 | NOT cast_expression
  253                 | BITNOT cast_expression
  254                 | SIZEOF unary_expression
  255                 | SIZEOF LEFT_PAREN type_id RIGHT_PAREN
  256                 | NEW type_id
  257                 | NEW type_id LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  258                 | NEW type_id LEFT_BRACKET expression RIGHT_BRACKET
  259                 | DELETE cast_expression
  260                 | DELETE LEFT_BRACKET RIGHT_BRACKET cast_expression

  261 postfix_expression: primary_expression
  262                   | postfix_expression LEFT_BRACKET expression RIGHT_BRACKET
  263                   | postfix_expression LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  264                   | postfix_expression DOT named_identifier
  265                   | postfix_expression ARROW named_identifier
  266                   | postfix_expression INC
  267                   | postfix_expression DEC

  268 argument_expression_list_opt: /* empty */
  269                             | argument_expression_list

  270 argument_expression_list: assignment_expression
  271                         | argument_expression_list COMMA assignment_expression

  272 primary_expression: IDENTIFIER
  273                   | IDENTIFIER SCOPE named_identifier
  274                   | INTEGER_LITERAL
  275                   | FLOAT_LITERAL
  276                   | EXPONENT_NUMBER_LITERAL
  277                   | HEXADECIMAL_LITERAL
  278                   | BINARY_LITERAL
  279                   | BOOLEAN_LITERAL
  280                   | STRING_LITERAL
  281                   | CHAR_LITERAL
  282                   | NULLPTR
  283                   | THIS
  284                   | PRINTF_FUNCTION
  285                   | SCANF_FUNCTION
  286                   | MALLOC_FUNCTION
  287                   | CALLOC_FUNCTION
  288                   | REALLOC_FUNCTION
  289                   | FREE_FUNCTION
  290                   | LEFT_PAREN expression RIGHT_PAREN
  291                   | lambda_expression

  292 lambda_expression: LEFT_BRACKET capture_list_opt RIGHT_BRACKET LEFT_PAREN parameter_list_opt RIGHT_PAREN lambda_return_opt compound_statement

  293 capture_list_opt: /* empty */
  294                 | capture_list

  295 capture_list: capture_item
  296             | capture_list COMMA capture_item

  297 capture_item: named_identifier
  298             | BITAND named_identifier
  299             | ASSIGN
  300             | BITAND

  301 lambda_return_opt: /* empty */
  302                  | ARROW type_id

  303 qualified_name: named_identifier
  304               | qualified_name SCOPE named_identifier

  305 named_identifier: IDENTIFIER


