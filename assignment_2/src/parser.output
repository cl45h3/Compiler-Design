Grammar

    0 $accept: translation_unit $end

    1 translation_unit: /* empty */
    2                 | translation_unit external_declaration

    3 external_declaration: preprocessor_directive
    4                     | function_definition
    5                     | function_declaration
    6                     | declaration
    7                     | typedef_declaration
    8                     | class_declaration
    9                     | struct_declaration
   10                     | enum_declaration
   11                     | union_declaration
   12                     | template_declaration
   13                     | error RIGHT_BRACE

   14 preprocessor_directive: PP_INCLUDE HEADER_NAME
   15                       | PP_DEFINE IDENTIFIER constant_expression
   16                       | PP_DEFINE IDENTIFIER
   17                       | IDENTIFIER MALFORMED_DIRECTIVE

   18 template_declaration: template_head external_declaration

   19 template_head: TEMPLATE LT TYPENAME IDENTIFIER GT
   20              | TEMPLATE LT CLASS IDENTIFIER GT

   21 class_head: CLASS named_identifier

   22 struct_head: STRUCT named_identifier

   23 enum_head: ENUM named_identifier

   24 union_head: UNION named_identifier

   25 class_declaration: class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   26                  | class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE

   27 inheritance_opt: /* empty */
   28                | COLON access_specifier_opt base_class_list

   29 access_specifier_opt: /* empty */
   30                     | access_specifier

   31 access_specifier: PUBLIC
   32                 | PRIVATE
   33                 | PROTECTED

   34 base_class_list: qualified_name
   35                | TYPE_NAME
   36                | base_class_list COMMA access_specifier_opt qualified_name

   37 member_list: /* empty */
   38            | member_list member_declaration

   39 member_declaration: access_specifier COLON
   40                   | function_definition
   41                   | function_declaration
   42                   | declaration
   43                   | typedef_declaration
   44                   | class_declaration
   45                   | struct_declaration
   46                   | enum_declaration
   47                   | union_declaration
   48                   | constructor_definition

   49 constructor_definition: qualified_name LEFT_PAREN parameter_list_opt RIGHT_PAREN compound_statement

   50 struct_declaration: struct_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   51                   | struct_head LEFT_BRACE member_list RIGHT_BRACE

   52 union_declaration: union_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   53                  | union_head LEFT_BRACE member_list RIGHT_BRACE

   54 enum_declaration: enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE SEMICOLON
   55                 | enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE

   56 enumerator_list_opt: /* empty */
   57                    | enumerator_list

   58 enumerator_list: named_identifier
   59                | named_identifier ASSIGN constant_expression
   60                | enumerator_list COMMA named_identifier
   61                | enumerator_list COMMA named_identifier ASSIGN constant_expression

   62 function_definition: declaration_specifiers function_declarator compound_statement

   63 declaration: declaration_specifiers init_declarator_list SEMICOLON

   64 function_declaration: declaration_specifiers function_declarator SEMICOLON

   65 typedef_declaration: TYPEDEF declaration_specifiers typedef_declarator_list SEMICOLON

   66 typedef_declarator_list: typedef_declarator
   67                        | typedef_declarator_list COMMA typedef_declarator

   68 typedef_declarator: declarator
   69                   | declarator ASSIGN initializer

   70 declaration_specifiers: declaration_prefix_opt type_specifier type_suffixes

   71 declaration_prefix_opt: /* empty */
   72                       | declaration_prefix_opt declaration_prefix

   73 declaration_prefix: type_qualifier
   74                   | storage_class_specifier
   75                   | function_specifier
   76                   | constexpr_specifier

   77 type_suffixes: /* empty */
   78              | type_suffixes type_suffix

   79 type_suffix: SHORT
   80            | LONG
   81            | LONG_LONG
   82            | SIGNED
   83            | UNSIGNED
   84            | CONST
   85            | VOLATILE

   86 storage_class_specifier: STATIC
   87                        | EXTERN
   88                        | REGISTER
   89                        | FRIEND

   90 function_specifier: INLINE

   91 constexpr_specifier: CONSTEXPR

   92 type_qualifier: CONST
   93               | VOLATILE

   94 type_specifier: VOID
   95               | CHAR
   96               | INT
   97               | FLOAT
   98               | DOUBLE
   99               | BOOL
  100               | AUTO
  101               | SHORT
  102               | LONG
  103               | LONG_LONG
  104               | SIGNED
  105               | UNSIGNED
  106               | TYPE_NAME
  107               | STRUCT named_identifier
  108               | STRUCT TYPE_NAME
  109               | ENUM named_identifier
  110               | ENUM TYPE_NAME
  111               | UNION named_identifier
  112               | UNION TYPE_NAME
  113               | TYPENAME qualified_name

  114 init_declarator_list: init_declarator
  115                     | init_declarator_list COMMA init_declarator

  116 init_declarator: declarator
  117                | declarator ASSIGN initializer
  118                | declarator LEFT_PAREN argument_expression_list_opt RIGHT_PAREN

  119 initializer: assignment_expression
  120            | LEFT_BRACE initializer_list_opt RIGHT_BRACE

  121 initializer_list_opt: /* empty */
  122                     | initializer_list

  123 initializer_list: initializer
  124                 | initializer_list COMMA initializer
  125                 | initializer_list COMMA

  126 declarator: pointer_opt reference_opt direct_declarator
  127           | function_pointer_declarator

  128 reference_opt: /* empty */
  129              | reference

  130 reference: BITAND
  131          | ANDAND

  132 pointer_opt: /* empty */
  133            | pointer

  134 pointer: STAR pointer_after_star

  135 pointer_after_star: /* empty */
  136                   | pointer
  137                   | type_qualifier_list pointer_after_star

  138 type_qualifier_list: type_qualifier

  139 direct_declarator: qualified_name
  140                  | OPERATOR overload_operator
  141                  | LEFT_PAREN declarator RIGHT_PAREN
  142                  | direct_declarator LEFT_BRACKET constant_expression_opt RIGHT_BRACKET

  143 function_pointer_declarator: LEFT_PAREN pointer named_identifier RIGHT_PAREN LEFT_PAREN parameter_list_opt RIGHT_PAREN

  144 function_declarator: pointer_opt reference_opt function_direct_declarator function_cv_qualifier_seq_opt

  145 function_cv_qualifier_seq_opt: /* empty */
  146                              | function_cv_qualifier_seq_opt type_qualifier

  147 function_direct_declarator: named_identifier LEFT_PAREN parameter_list_opt RIGHT_PAREN
  148                           | qualified_name LEFT_PAREN parameter_list_opt RIGHT_PAREN
  149                           | OPERATOR overload_operator LEFT_PAREN parameter_list_opt RIGHT_PAREN
  150                           | LEFT_PAREN function_declarator RIGHT_PAREN LEFT_PAREN parameter_list_opt RIGHT_PAREN

  151 overload_operator: PLUS
  152                  | MINUS
  153                  | STAR
  154                  | SLASH
  155                  | PERCENT
  156                  | ASSIGN
  157                  | EQ
  158                  | LT
  159                  | GT
  160                  | LEFT_BRACKET RIGHT_BRACKET
  161                  | LEFT_PAREN RIGHT_PAREN

  162 constant_expression_opt: /* empty */
  163                        | constant_expression

  164 parameter_list_opt: /* empty */
  165                   | parameter_list

  166 parameter_list: parameter_declaration
  167               | parameter_list COMMA parameter_declaration
  168               | parameter_list COMMA ELLIPSIS
  169               | ELLIPSIS

  170 parameter_declaration: declaration_specifiers parameter_declarator default_argument_opt
  171                      | declaration_specifiers default_argument_opt

  172 parameter_declarator: declarator

  173 default_argument_opt: /* empty */
  174                     | ASSIGN initializer

  175 compound_statement: LEFT_BRACE block_item_list_opt RIGHT_BRACE

  176 block_item_list_opt: /* empty */
  177                    | block_item_list

  178 block_item_list: block_item
  179                | block_item_list block_item

  180 block_item: statement
  181           | declaration
  182           | typedef_declaration

  183 statement: compound_statement
  184          | expression_statement
  185          | selection_statement
  186          | iteration_statement
  187          | jump_statement
  188          | labeled_statement
  189          | error SEMICOLON

  190 expression_statement: expression_opt SEMICOLON

  191 selection_statement: IF LEFT_PAREN expression RIGHT_PAREN statement
  192                    | IF LEFT_PAREN expression RIGHT_PAREN statement ELSE statement
  193                    | SWITCH LEFT_PAREN expression RIGHT_PAREN statement

  194 iteration_statement: WHILE LEFT_PAREN expression RIGHT_PAREN statement
  195                    | UNTIL LEFT_PAREN expression RIGHT_PAREN statement
  196                    | DO statement WHILE LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  197                    | DO statement UNTIL LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  198                    | FOR LEFT_PAREN for_init_opt SEMICOLON expression_opt SEMICOLON expression_opt RIGHT_PAREN statement

  199 for_init_opt: /* empty */
  200             | expression
  201             | declaration_specifiers init_declarator_list

  202 jump_statement: GOTO named_identifier SEMICOLON
  203               | CONTINUE SEMICOLON
  204               | BREAK SEMICOLON
  205               | RETURN expression_opt SEMICOLON

  206 labeled_statement: named_identifier COLON statement
  207                  | CASE constant_expression COLON statement
  208                  | DEFAULT COLON statement

  209 expression_opt: /* empty */
  210               | expression

  211 expression: assignment_expression
  212           | expression COMMA assignment_expression

  213 assignment_expression: conditional_expression
  214                      | logical_or_expression assignment_operator assignment_expression

  215 assignment_operator: ASSIGN
  216                    | ADD_ASSIGN
  217                    | SUB_ASSIGN
  218                    | MUL_ASSIGN
  219                    | DIV_ASSIGN
  220                    | MOD_ASSIGN
  221                    | AND_ASSIGN
  222                    | OR_ASSIGN
  223                    | XOR_ASSIGN
  224                    | SHL_ASSIGN
  225                    | SHR_ASSIGN

  226 conditional_expression: logical_or_expression
  227                       | logical_or_expression QUESTION_MARK expression COLON conditional_expression

  228 constant_expression: conditional_expression

  229 logical_or_expression: logical_and_expression
  230                      | logical_or_expression OROR logical_and_expression

  231 logical_and_expression: inclusive_or_expression
  232                       | logical_and_expression ANDAND inclusive_or_expression

  233 inclusive_or_expression: exclusive_or_expression
  234                        | inclusive_or_expression BITOR exclusive_or_expression

  235 exclusive_or_expression: and_expression
  236                        | exclusive_or_expression BITXOR and_expression

  237 and_expression: equality_expression
  238               | and_expression BITAND equality_expression

  239 equality_expression: relational_expression
  240                    | equality_expression EQ relational_expression
  241                    | equality_expression NE relational_expression

  242 relational_expression: shift_expression
  243                      | relational_expression LT shift_expression
  244                      | relational_expression GT shift_expression
  245                      | relational_expression LE shift_expression
  246                      | relational_expression GE shift_expression

  247 shift_expression: additive_expression
  248                 | shift_expression SHL additive_expression
  249                 | shift_expression SHR additive_expression

  250 additive_expression: multiplicative_expression
  251                    | additive_expression PLUS multiplicative_expression
  252                    | additive_expression MINUS multiplicative_expression

  253 multiplicative_expression: cast_expression
  254                          | multiplicative_expression STAR cast_expression
  255                          | multiplicative_expression SLASH cast_expression
  256                          | multiplicative_expression PERCENT cast_expression

  257 cast_expression: unary_expression
  258                | LEFT_PAREN type_id RIGHT_PAREN cast_expression

  259 type_id: declaration_specifiers pointer_opt

  260 unary_expression: postfix_expression
  261                 | INC unary_expression
  262                 | DEC unary_expression
  263                 | BITAND cast_expression
  264                 | STAR cast_expression
  265                 | PLUS cast_expression
  266                 | MINUS cast_expression
  267                 | NOT cast_expression
  268                 | BITNOT cast_expression
  269                 | SIZEOF unary_expression
  270                 | SIZEOF LEFT_PAREN type_id RIGHT_PAREN
  271                 | NEW type_id
  272                 | NEW type_id LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  273                 | NEW type_id LEFT_BRACKET expression RIGHT_BRACKET
  274                 | DELETE cast_expression
  275                 | DELETE LEFT_BRACKET RIGHT_BRACKET cast_expression

  276 postfix_expression: primary_expression
  277                   | postfix_expression LEFT_BRACKET expression RIGHT_BRACKET
  278                   | postfix_expression LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  279                   | postfix_expression DOT named_identifier
  280                   | postfix_expression ARROW named_identifier
  281                   | postfix_expression INC
  282                   | postfix_expression DEC

  283 argument_expression_list_opt: /* empty */
  284                             | argument_expression_list

  285 argument_expression_list: assignment_expression
  286                         | argument_expression_list COMMA assignment_expression

  287 primary_expression: IDENTIFIER
  288                   | IDENTIFIER SCOPE named_identifier
  289                   | INTEGER_LITERAL
  290                   | FLOAT_LITERAL
  291                   | EXPONENT_NUMBER_LITERAL
  292                   | HEXADECIMAL_LITERAL
  293                   | BINARY_LITERAL
  294                   | BOOLEAN_LITERAL
  295                   | STRING_LITERAL
  296                   | CHAR_LITERAL
  297                   | NULLPTR
  298                   | THIS
  299                   | PRINTF_FUNCTION
  300                   | SCANF_FUNCTION
  301                   | MALLOC_FUNCTION
  302                   | CALLOC_FUNCTION
  303                   | REALLOC_FUNCTION
  304                   | FREE_FUNCTION
  305                   | LEFT_PAREN expression RIGHT_PAREN
  306                   | lambda_expression

  307 lambda_expression: LEFT_BRACKET capture_list_opt RIGHT_BRACKET LEFT_PAREN parameter_list_opt RIGHT_PAREN lambda_return_opt compound_statement

  308 capture_list_opt: /* empty */
  309                 | capture_list

  310 capture_list: capture_item
  311             | capture_list COMMA capture_item

  312 capture_item: named_identifier
  313             | BITAND named_identifier
  314             | ASSIGN
  315             | BITAND

  316 lambda_return_opt: /* empty */
  317                  | ARROW type_id

  318 qualified_name: named_identifier
  319               | qualified_name SCOPE named_identifier

  320 named_identifier: IDENTIFIER


