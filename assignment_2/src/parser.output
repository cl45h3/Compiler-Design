Grammar

    0 $accept: translation_unit $end

    1 translation_unit: /* empty */
    2                 | translation_unit external_declaration

    3 external_declaration: preprocessor_directive
    4                     | function_definition
    5                     | function_declaration
    6                     | declaration
    7                     | typedef_declaration
    8                     | class_declaration
    9                     | struct_declaration
   10                     | enum_declaration
   11                     | union_declaration
   12                     | template_declaration
   13                     | error RIGHT_BRACE

   14 preprocessor_directive: PP_INCLUDE HEADER_NAME
   15                       | PP_DEFINE IDENTIFIER constant_expression
   16                       | PP_DEFINE IDENTIFIER
   17                       | IDENTIFIER MALFORMED_DIRECTIVE

   18 template_declaration: template_head external_declaration

   19 template_head: TEMPLATE LT TYPENAME IDENTIFIER GT
   20              | TEMPLATE LT CLASS IDENTIFIER GT

   21 class_head: CLASS named_identifier

   22 struct_head: STRUCT named_identifier

   23 enum_head: ENUM named_identifier

   24 union_head: UNION named_identifier

   25 class_declaration: class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   26                  | class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE

   27 inheritance_opt: /* empty */
   28                | COLON access_specifier_opt base_class_list

   29 access_specifier_opt: /* empty */
   30                     | access_specifier

   31 access_specifier: PUBLIC
   32                 | PRIVATE
   33                 | PROTECTED

   34 base_class_list: qualified_name
   35                | TYPE_NAME
   36                | base_class_list COMMA access_specifier_opt qualified_name

   37 member_list: /* empty */
   38            | member_list member_declaration

   39 member_declaration: access_specifier COLON
   40                   | function_definition
   41                   | function_declaration
   42                   | declaration
   43                   | typedef_declaration
   44                   | class_declaration
   45                   | struct_declaration
   46                   | enum_declaration
   47                   | union_declaration
   48                   | constructor_definition

   49 constructor_definition: qualified_name LEFT_PAREN parameter_list_opt RIGHT_PAREN compound_statement

   50 struct_declaration: struct_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   51                   | struct_head LEFT_BRACE member_list RIGHT_BRACE

   52 union_declaration: union_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   53                  | union_head LEFT_BRACE member_list RIGHT_BRACE

   54 enum_declaration: enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE SEMICOLON
   55                 | enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE

   56 enumerator_list_opt: /* empty */
   57                    | enumerator_list

   58 enumerator_list: named_identifier
   59                | named_identifier ASSIGN constant_expression
   60                | enumerator_list COMMA named_identifier
   61                | enumerator_list COMMA named_identifier ASSIGN constant_expression

   62 function_definition: declaration_specifiers function_declarator compound_statement

   63 declaration: declaration_specifiers init_declarator_list SEMICOLON

   64 function_declaration: declaration_specifiers function_declarator SEMICOLON

   65 typedef_declaration: TYPEDEF declaration_specifiers typedef_declarator_list SEMICOLON

   66 typedef_declarator_list: typedef_declarator
   67                        | typedef_declarator_list COMMA typedef_declarator

   68 typedef_declarator: declarator
   69                   | declarator ASSIGN initializer

   70 declaration_specifiers: declaration_prefix_opt type_specifier type_suffixes

   71 declaration_prefix_opt: /* empty */
   72                       | declaration_prefix_opt declaration_prefix

   73 declaration_prefix: type_qualifier
   74                   | storage_class_specifier
   75                   | function_specifier

   76 type_suffixes: /* empty */
   77              | type_suffixes type_suffix

   78 type_suffix: SHORT
   79            | LONG
   80            | LONG_LONG
   81            | SIGNED
   82            | UNSIGNED
   83            | CONST
   84            | VOLATILE

   85 storage_class_specifier: STATIC
   86                        | EXTERN
   87                        | REGISTER
   88                        | FRIEND

   89 function_specifier: INLINE

   90 type_qualifier: CONST
   91               | VOLATILE

   92 type_specifier: VOID
   93               | CHAR
   94               | INT
   95               | FLOAT
   96               | DOUBLE
   97               | BOOL
   98               | AUTO
   99               | SHORT
  100               | LONG
  101               | LONG_LONG
  102               | SIGNED
  103               | UNSIGNED
  104               | TYPE_NAME
  105               | STRUCT named_identifier
  106               | STRUCT TYPE_NAME
  107               | ENUM named_identifier
  108               | ENUM TYPE_NAME
  109               | UNION named_identifier
  110               | UNION TYPE_NAME
  111               | TYPENAME qualified_name

  112 init_declarator_list: init_declarator
  113                     | init_declarator_list COMMA init_declarator

  114 init_declarator: declarator
  115                | declarator ASSIGN initializer
  116                | declarator LEFT_PAREN argument_expression_list_opt RIGHT_PAREN

  117 initializer: assignment_expression
  118            | LEFT_BRACE initializer_list_opt RIGHT_BRACE

  119 initializer_list_opt: /* empty */
  120                     | initializer_list

  121 initializer_list: initializer
  122                 | initializer_list COMMA initializer
  123                 | initializer_list COMMA

  124 declarator: pointer_opt reference_opt direct_declarator
  125           | function_pointer_declarator

  126 reference_opt: /* empty */
  127              | reference

  128 reference: BITAND
  129          | BITAND reference

  130 pointer_opt: /* empty */
  131            | pointer

  132 pointer: STAR pointer_after_star

  133 pointer_after_star: /* empty */
  134                   | pointer
  135                   | type_qualifier_list pointer_after_star

  136 type_qualifier_list: type_qualifier

  137 direct_declarator: qualified_name
  138                  | OPERATOR overload_operator
  139                  | LEFT_PAREN declarator RIGHT_PAREN
  140                  | direct_declarator LEFT_BRACKET constant_expression_opt RIGHT_BRACKET

  141 function_pointer_declarator: LEFT_PAREN pointer named_identifier RIGHT_PAREN LEFT_PAREN parameter_list_opt RIGHT_PAREN

  142 function_declarator: pointer_opt reference_opt function_direct_declarator

  143 function_direct_declarator: named_identifier LEFT_PAREN parameter_list_opt RIGHT_PAREN
  144                           | qualified_name LEFT_PAREN parameter_list_opt RIGHT_PAREN
  145                           | OPERATOR overload_operator LEFT_PAREN parameter_list_opt RIGHT_PAREN
  146                           | LEFT_PAREN function_declarator RIGHT_PAREN LEFT_PAREN parameter_list_opt RIGHT_PAREN

  147 overload_operator: PLUS
  148                  | MINUS
  149                  | STAR
  150                  | SLASH
  151                  | PERCENT
  152                  | ASSIGN
  153                  | EQ
  154                  | LT
  155                  | GT
  156                  | LEFT_BRACKET RIGHT_BRACKET
  157                  | LEFT_PAREN RIGHT_PAREN

  158 constant_expression_opt: /* empty */
  159                        | constant_expression

  160 parameter_list_opt: /* empty */
  161                   | parameter_list

  162 parameter_list: parameter_declaration
  163               | parameter_list COMMA parameter_declaration
  164               | parameter_list COMMA ELLIPSIS
  165               | ELLIPSIS

  166 parameter_declaration: declaration_specifiers declarator
  167                      | declaration_specifiers

  168 compound_statement: LEFT_BRACE block_item_list_opt RIGHT_BRACE

  169 block_item_list_opt: /* empty */
  170                    | block_item_list

  171 block_item_list: block_item
  172                | block_item_list block_item

  173 block_item: statement
  174           | declaration
  175           | typedef_declaration

  176 statement: compound_statement
  177          | expression_statement
  178          | selection_statement
  179          | iteration_statement
  180          | jump_statement
  181          | labeled_statement
  182          | error SEMICOLON

  183 expression_statement: expression_opt SEMICOLON

  184 selection_statement: IF LEFT_PAREN expression RIGHT_PAREN statement
  185                    | IF LEFT_PAREN expression RIGHT_PAREN statement ELSE statement
  186                    | SWITCH LEFT_PAREN expression RIGHT_PAREN statement

  187 iteration_statement: WHILE LEFT_PAREN expression RIGHT_PAREN statement
  188                    | UNTIL LEFT_PAREN expression RIGHT_PAREN statement
  189                    | DO statement WHILE LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  190                    | DO statement UNTIL LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  191                    | FOR LEFT_PAREN for_init_opt SEMICOLON expression_opt SEMICOLON expression_opt RIGHT_PAREN statement

  192 for_init_opt: /* empty */
  193             | expression
  194             | declaration_specifiers init_declarator_list

  195 jump_statement: GOTO named_identifier SEMICOLON
  196               | CONTINUE SEMICOLON
  197               | BREAK SEMICOLON
  198               | RETURN expression_opt SEMICOLON

  199 labeled_statement: named_identifier COLON statement
  200                  | CASE constant_expression COLON statement
  201                  | DEFAULT COLON statement

  202 expression_opt: /* empty */
  203               | expression

  204 expression: assignment_expression
  205           | expression COMMA assignment_expression

  206 assignment_expression: conditional_expression
  207                      | unary_expression assignment_operator assignment_expression

  208 assignment_operator: ASSIGN
  209                    | ADD_ASSIGN
  210                    | SUB_ASSIGN
  211                    | MUL_ASSIGN
  212                    | DIV_ASSIGN
  213                    | MOD_ASSIGN
  214                    | AND_ASSIGN
  215                    | OR_ASSIGN
  216                    | XOR_ASSIGN
  217                    | SHL_ASSIGN
  218                    | SHR_ASSIGN

  219 conditional_expression: logical_or_expression
  220                       | logical_or_expression QUESTION_MARK expression COLON conditional_expression

  221 constant_expression: conditional_expression

  222 logical_or_expression: logical_and_expression
  223                      | logical_or_expression OROR logical_and_expression

  224 logical_and_expression: inclusive_or_expression
  225                       | logical_and_expression ANDAND inclusive_or_expression

  226 inclusive_or_expression: exclusive_or_expression
  227                        | inclusive_or_expression BITOR exclusive_or_expression

  228 exclusive_or_expression: and_expression
  229                        | exclusive_or_expression BITXOR and_expression

  230 and_expression: equality_expression
  231               | and_expression BITAND equality_expression

  232 equality_expression: relational_expression
  233                    | equality_expression EQ relational_expression
  234                    | equality_expression NE relational_expression

  235 relational_expression: shift_expression
  236                      | relational_expression LT shift_expression
  237                      | relational_expression GT shift_expression
  238                      | relational_expression LE shift_expression
  239                      | relational_expression GE shift_expression

  240 shift_expression: additive_expression
  241                 | shift_expression SHL additive_expression
  242                 | shift_expression SHR additive_expression

  243 additive_expression: multiplicative_expression
  244                    | additive_expression PLUS multiplicative_expression
  245                    | additive_expression MINUS multiplicative_expression

  246 multiplicative_expression: cast_expression
  247                          | multiplicative_expression STAR cast_expression
  248                          | multiplicative_expression SLASH cast_expression
  249                          | multiplicative_expression PERCENT cast_expression

  250 cast_expression: unary_expression
  251                | LEFT_PAREN type_id RIGHT_PAREN cast_expression

  252 type_id: declaration_specifiers pointer_opt

  253 unary_expression: postfix_expression
  254                 | INC unary_expression
  255                 | DEC unary_expression
  256                 | BITAND cast_expression
  257                 | STAR cast_expression
  258                 | PLUS cast_expression
  259                 | MINUS cast_expression
  260                 | NOT cast_expression
  261                 | BITNOT cast_expression
  262                 | SIZEOF unary_expression
  263                 | SIZEOF LEFT_PAREN type_id RIGHT_PAREN
  264                 | NEW type_id
  265                 | NEW type_id LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  266                 | NEW type_id LEFT_BRACKET expression RIGHT_BRACKET
  267                 | DELETE cast_expression
  268                 | DELETE LEFT_BRACKET RIGHT_BRACKET cast_expression

  269 postfix_expression: primary_expression
  270                   | postfix_expression LEFT_BRACKET expression RIGHT_BRACKET
  271                   | postfix_expression LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  272                   | postfix_expression DOT named_identifier
  273                   | postfix_expression ARROW named_identifier
  274                   | postfix_expression INC
  275                   | postfix_expression DEC

  276 argument_expression_list_opt: /* empty */
  277                             | argument_expression_list

  278 argument_expression_list: assignment_expression
  279                         | argument_expression_list COMMA assignment_expression

  280 primary_expression: IDENTIFIER
  281                   | IDENTIFIER SCOPE named_identifier
  282                   | INTEGER_LITERAL
  283                   | FLOAT_LITERAL
  284                   | EXPONENT_NUMBER_LITERAL
  285                   | HEXADECIMAL_LITERAL
  286                   | BINARY_LITERAL
  287                   | BOOLEAN_LITERAL
  288                   | STRING_LITERAL
  289                   | CHAR_LITERAL
  290                   | NULLPTR
  291                   | THIS
  292                   | PRINTF_FUNCTION
  293                   | SCANF_FUNCTION
  294                   | MALLOC_FUNCTION
  295                   | CALLOC_FUNCTION
  296                   | REALLOC_FUNCTION
  297                   | FREE_FUNCTION
  298                   | LEFT_PAREN expression RIGHT_PAREN
  299                   | lambda_expression

  300 lambda_expression: LEFT_BRACKET capture_list_opt RIGHT_BRACKET LEFT_PAREN parameter_list_opt RIGHT_PAREN lambda_return_opt compound_statement

  301 capture_list_opt: /* empty */
  302                 | capture_list

  303 capture_list: capture_item
  304             | capture_list COMMA capture_item

  305 capture_item: named_identifier
  306             | BITAND named_identifier
  307             | ASSIGN
  308             | BITAND

  309 lambda_return_opt: /* empty */
  310                  | ARROW type_id

  311 qualified_name: named_identifier
  312               | qualified_name SCOPE named_identifier

  313 named_identifier: IDENTIFIER


