Grammar

    0 $accept: translation_unit $end

    1 translation_unit: /* empty */
    2                 | translation_unit external_declaration

    3 external_declaration: preprocessor_directive
    4                     | function_definition
    5                     | function_declaration
    6                     | declaration
    7                     | typedef_declaration
    8                     | class_declaration
    9                     | struct_declaration
   10                     | enum_declaration
   11                     | union_declaration
   12                     | template_declaration
   13                     | error SEMICOLON
   14                     | error RIGHT_BRACE

   15 preprocessor_directive: PP_INCLUDE HEADER_NAME
   16                       | PP_DEFINE IDENTIFIER constant_expression
   17                       | PP_DEFINE IDENTIFIER
   18                       | IDENTIFIER MALFORMED_DIRECTIVE

   19 template_declaration: template_head external_declaration

   20 template_head: TEMPLATE LT TYPENAME IDENTIFIER GT
   21              | TEMPLATE LT CLASS IDENTIFIER GT

   22 class_head: CLASS tag_identifier

   23 struct_head: STRUCT tag_identifier

   24 enum_head: ENUM tag_identifier

   25 union_head: UNION tag_identifier

   26 class_declaration: class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   27                  | class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE
   28                  | class_head LEFT_PAREN error RIGHT_PAREN LEFT_BRACE member_list RIGHT_BRACE SEMICOLON

   29 inheritance_opt: /* empty */
   30                | COLON access_specifier_opt base_class_list

   31 access_specifier_opt: /* empty */
   32                     | access_specifier

   33 access_specifier: PUBLIC
   34                 | PRIVATE
   35                 | PROTECTED

   36 base_class_list: qualified_name
   37                | TYPE_NAME
   38                | base_class_list COMMA access_specifier_opt qualified_name

   39 member_list: /* empty */
   40            | member_list member_declaration

   41 member_declaration: access_specifier COLON
   42                   | function_definition
   43                   | function_declaration
   44                   | declaration
   45                   | typedef_declaration
   46                   | class_declaration
   47                   | struct_declaration
   48                   | enum_declaration
   49                   | union_declaration
   50                   | constructor_definition

   51 constructor_definition: qualified_name LEFT_PAREN parameter_list_opt RIGHT_PAREN compound_statement

   52 struct_declaration: struct_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   53                   | struct_head LEFT_BRACE member_list RIGHT_BRACE
   54                   | struct_head LEFT_PAREN error RIGHT_PAREN LEFT_BRACE member_list RIGHT_BRACE SEMICOLON

   55 union_declaration: union_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   56                  | union_head LEFT_BRACE member_list RIGHT_BRACE

   57 enum_declaration: enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE SEMICOLON
   58                 | enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE

   59 enumerator_list_opt: /* empty */
   60                    | enumerator_list

   61 enumerator_list: named_identifier
   62                | named_identifier ASSIGN constant_expression
   63                | enumerator_list COMMA named_identifier
   64                | enumerator_list COMMA named_identifier ASSIGN constant_expression

   65 function_definition: declaration_specifiers function_declarator compound_statement

   66 declaration: declaration_specifiers init_declarator_list SEMICOLON
   67            | declaration_specifiers init_declarator_list

   68 function_declaration: declaration_specifiers function_declarator SEMICOLON

   69 typedef_declaration: TYPEDEF declaration_specifiers typedef_declarator_list SEMICOLON

   70 typedef_declarator_list: typedef_declarator
   71                        | typedef_declarator_list COMMA typedef_declarator

   72 typedef_declarator: declarator
   73                   | declarator ASSIGN initializer

   74 declaration_specifiers: declaration_prefix_opt type_specifier type_suffixes

   75 declaration_prefix_opt: /* empty */
   76                       | declaration_prefix_opt declaration_prefix

   77 declaration_prefix: type_qualifier
   78                   | storage_class_specifier
   79                   | function_specifier
   80                   | constexpr_specifier

   81 type_suffixes: /* empty */
   82              | type_suffixes type_suffix

   83 type_suffix: SHORT
   84            | LONG
   85            | LONG_LONG
   86            | SIGNED
   87            | UNSIGNED
   88            | CONST
   89            | VOLATILE

   90 storage_class_specifier: STATIC
   91                        | EXTERN
   92                        | REGISTER
   93                        | FRIEND

   94 function_specifier: INLINE

   95 constexpr_specifier: CONSTEXPR

   96 type_qualifier: CONST
   97               | VOLATILE

   98 type_specifier: VOID
   99               | CHAR
  100               | INT
  101               | FLOAT
  102               | DOUBLE
  103               | BOOL
  104               | AUTO
  105               | SHORT
  106               | LONG
  107               | LONG_LONG
  108               | SIGNED
  109               | UNSIGNED
  110               | TYPE_NAME
  111               | STRUCT tag_identifier
  112               | ENUM tag_identifier
  113               | UNION tag_identifier
  114               | TYPENAME qualified_name

  115 init_declarator_list: init_declarator
  116                     | init_declarator_list COMMA init_declarator

  117 init_declarator: declarator
  118                | declarator ASSIGN initializer
  119                | declarator LEFT_PAREN argument_expression_list_opt RIGHT_PAREN

  120 initializer: assignment_expression
  121            | LEFT_BRACE initializer_list_opt RIGHT_BRACE

  122 initializer_list_opt: /* empty */
  123                     | initializer_list

  124 initializer_list: initializer
  125                 | initializer_list COMMA initializer
  126                 | initializer_list COMMA

  127 declarator: pointer_opt reference_opt direct_declarator
  128           | function_pointer_declarator

  129 reference_opt: /* empty */
  130              | reference

  131 reference: BITAND
  132          | ANDAND

  133 pointer_opt: /* empty */
  134            | pointer

  135 pointer: STAR pointer_after_star

  136 pointer_after_star: /* empty */
  137                   | pointer
  138                   | type_qualifier_list pointer_after_star

  139 type_qualifier_list: type_qualifier

  140 direct_declarator: qualified_name
  141                  | OPERATOR overload_operator
  142                  | LEFT_PAREN declarator RIGHT_PAREN
  143                  | direct_declarator LEFT_BRACKET constant_expression_opt RIGHT_BRACKET

  144 function_pointer_declarator: LEFT_PAREN pointer named_identifier RIGHT_PAREN LEFT_PAREN parameter_list_opt RIGHT_PAREN

  145 constant_expression_opt: /* empty */
  146                        | constant_expression

  147 function_declarator: pointer_opt reference_opt function_direct_declarator function_cv_qualifier_seq_opt

  148 function_cv_qualifier_seq_opt: /* empty */
  149                              | function_cv_qualifier_seq_opt type_qualifier

  150 function_direct_declarator: named_identifier LEFT_PAREN parameter_list_opt RIGHT_PAREN
  151                           | qualified_name LEFT_PAREN parameter_list_opt RIGHT_PAREN
  152                           | OPERATOR overload_operator LEFT_PAREN parameter_list_opt RIGHT_PAREN
  153                           | LEFT_PAREN function_declarator RIGHT_PAREN LEFT_PAREN parameter_list_opt RIGHT_PAREN

  154 overload_operator: PLUS
  155                  | MINUS
  156                  | STAR
  157                  | SLASH
  158                  | PERCENT
  159                  | ASSIGN
  160                  | EQ
  161                  | LT
  162                  | GT
  163                  | LEFT_BRACKET RIGHT_BRACKET
  164                  | LEFT_PAREN RIGHT_PAREN

  165 parameter_list_opt: /* empty */
  166                   | parameter_list

  167 parameter_list: parameter_declaration
  168               | parameter_list COMMA parameter_declaration
  169               | parameter_list COMMA ELLIPSIS
  170               | ELLIPSIS

  171 parameter_declaration: declaration_specifiers parameter_declarator default_argument_opt
  172                      | declaration_specifiers default_argument_opt

  173 parameter_declarator: declarator

  174 default_argument_opt: /* empty */
  175                     | ASSIGN initializer

  176 compound_statement: LEFT_BRACE block_item_list_opt RIGHT_BRACE

  177 block_item_list_opt: /* empty */
  178                    | block_item_list

  179 block_item_list: block_item
  180                | block_item_list block_item

  181 block_item: statement
  182           | declaration
  183           | typedef_declaration

  184 statement: compound_statement
  185          | expression_statement
  186          | selection_statement
  187          | iteration_statement
  188          | jump_statement
  189          | labeled_statement
  190          | error SEMICOLON

  191 expression_statement: expression_opt SEMICOLON

  192 selection_statement: IF LEFT_PAREN expression RIGHT_PAREN statement
  193                    | IF LEFT_PAREN expression RIGHT_PAREN statement ELSE statement
  194                    | SWITCH LEFT_PAREN expression RIGHT_PAREN statement

  195 iteration_statement: WHILE LEFT_PAREN expression RIGHT_PAREN statement
  196                    | UNTIL LEFT_PAREN expression RIGHT_PAREN statement
  197                    | DO statement WHILE LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  198                    | DO statement UNTIL LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  199                    | FOR LEFT_PAREN for_init_opt SEMICOLON expression_opt SEMICOLON expression_opt RIGHT_PAREN statement

  200 for_init_opt: /* empty */
  201             | expression
  202             | declaration_specifiers init_declarator_list

  203 jump_statement: GOTO named_identifier SEMICOLON
  204               | CONTINUE SEMICOLON
  205               | BREAK SEMICOLON
  206               | RETURN expression_opt SEMICOLON

  207 labeled_statement: named_identifier COLON statement
  208                  | CASE constant_expression COLON statement
  209                  | DEFAULT COLON statement

  210 expression_opt: /* empty */
  211               | expression

  212 expression: assignment_expression
  213           | expression COMMA assignment_expression

  214 assignment_expression: conditional_expression
  215                      | logical_or_expression assignment_operator assignment_expression

  216 assignment_operator: ASSIGN
  217                    | ADD_ASSIGN
  218                    | SUB_ASSIGN
  219                    | MUL_ASSIGN
  220                    | DIV_ASSIGN
  221                    | MOD_ASSIGN
  222                    | AND_ASSIGN
  223                    | OR_ASSIGN
  224                    | XOR_ASSIGN
  225                    | SHL_ASSIGN
  226                    | SHR_ASSIGN

  227 conditional_expression: logical_or_expression
  228                       | logical_or_expression QUESTION_MARK expression COLON conditional_expression

  229 constant_expression: conditional_expression

  230 logical_or_expression: logical_and_expression
  231                      | logical_or_expression OROR logical_and_expression

  232 logical_and_expression: inclusive_or_expression
  233                       | logical_and_expression ANDAND inclusive_or_expression

  234 inclusive_or_expression: exclusive_or_expression
  235                        | inclusive_or_expression BITOR exclusive_or_expression

  236 exclusive_or_expression: and_expression
  237                        | exclusive_or_expression BITXOR and_expression

  238 and_expression: equality_expression
  239               | and_expression BITAND equality_expression

  240 equality_expression: relational_expression
  241                    | equality_expression EQ relational_expression
  242                    | equality_expression NE relational_expression

  243 relational_expression: shift_expression
  244                      | relational_expression LT shift_expression
  245                      | relational_expression GT shift_expression
  246                      | relational_expression LE shift_expression
  247                      | relational_expression GE shift_expression

  248 shift_expression: additive_expression
  249                 | shift_expression SHL additive_expression
  250                 | shift_expression SHR additive_expression

  251 additive_expression: multiplicative_expression
  252                    | additive_expression PLUS multiplicative_expression
  253                    | additive_expression MINUS multiplicative_expression

  254 multiplicative_expression: cast_expression
  255                          | multiplicative_expression STAR cast_expression
  256                          | multiplicative_expression SLASH cast_expression
  257                          | multiplicative_expression PERCENT cast_expression

  258 cast_expression: unary_expression
  259                | LEFT_PAREN type_id RIGHT_PAREN cast_expression

  260 type_id: declaration_specifiers pointer_opt

  261 unary_expression: postfix_expression
  262                 | INC unary_expression
  263                 | DEC unary_expression
  264                 | BITAND cast_expression
  265                 | STAR cast_expression
  266                 | PLUS cast_expression
  267                 | MINUS cast_expression
  268                 | NOT cast_expression
  269                 | BITNOT cast_expression
  270                 | SIZEOF unary_expression
  271                 | SIZEOF LEFT_PAREN type_id RIGHT_PAREN
  272                 | NEW type_id
  273                 | NEW type_id LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  274                 | NEW type_id LEFT_BRACKET expression RIGHT_BRACKET
  275                 | DELETE cast_expression
  276                 | DELETE LEFT_BRACKET RIGHT_BRACKET cast_expression

  277 postfix_expression: primary_expression
  278                   | postfix_expression LEFT_BRACKET expression RIGHT_BRACKET
  279                   | postfix_expression LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  280                   | postfix_expression DOT named_identifier
  281                   | postfix_expression ARROW named_identifier
  282                   | postfix_expression INC
  283                   | postfix_expression DEC

  284 argument_expression_list_opt: /* empty */
  285                             | argument_expression_list

  286 argument_expression_list: assignment_expression
  287                         | argument_expression_list COMMA assignment_expression

  288 primary_expression: IDENTIFIER
  289                   | IDENTIFIER SCOPE named_identifier
  290                   | INTEGER_LITERAL
  291                   | FLOAT_LITERAL
  292                   | EXPONENT_NUMBER_LITERAL
  293                   | HEXADECIMAL_LITERAL
  294                   | BINARY_LITERAL
  295                   | BOOLEAN_LITERAL
  296                   | STRING_LITERAL
  297                   | CHAR_LITERAL
  298                   | NULLPTR
  299                   | THIS
  300                   | PRINTF_FUNCTION
  301                   | SCANF_FUNCTION
  302                   | MALLOC_FUNCTION
  303                   | CALLOC_FUNCTION
  304                   | REALLOC_FUNCTION
  305                   | FREE_FUNCTION
  306                   | LEFT_PAREN expression RIGHT_PAREN
  307                   | lambda_expression

  308 lambda_expression: LEFT_BRACKET capture_list_opt RIGHT_BRACKET LEFT_PAREN parameter_list_opt RIGHT_PAREN lambda_return_opt compound_statement

  309 capture_list_opt: /* empty */
  310                 | capture_list

  311 capture_list: capture_item
  312             | capture_list COMMA capture_item

  313 capture_item: named_identifier
  314             | BITAND named_identifier
  315             | ASSIGN
  316             | BITAND

  317 lambda_return_opt: /* empty */
  318                  | ARROW type_id

  319 qualified_name: named_identifier
  320               | qualified_name SCOPE named_identifier

  321 named_identifier: IDENTIFIER

  322 tag_identifier: IDENTIFIER
  323               | TYPE_NAME


