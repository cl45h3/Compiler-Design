Grammar

    0 $accept: translation_unit $end

    1 translation_unit: /* empty */
    2                 | translation_unit external_declaration

    3 external_declaration: preprocessor_directive
    4                     | function_definition
    5                     | function_declaration
    6                     | declaration
    7                     | typedef_declaration
    8                     | class_declaration
    9                     | enum_declaration
   10                     | union_declaration
   11                     | template_declaration
   12                     | malformed_function_definition
   13                     | error SEMICOLON
   14                     | error RIGHT_BRACE

   15 preprocessor_directive: PP_INCLUDE HEADER_NAME
   16                       | PP_DEFINE IDENTIFIER constant_expression
   17                       | PP_DEFINE IDENTIFIER
   18                       | IDENTIFIER MALFORMED_DIRECTIVE

   19 template_declaration: template_head external_declaration

   20 template_head: TEMPLATE LT TYPENAME IDENTIFIER GT
   21              | TEMPLATE LT CLASS IDENTIFIER GT

   22 class_head: CLASS class_identifier

   23 class_identifier: IDENTIFIER
   24                 | TYPE_NAME

   25 enum_head: ENUM tag_identifier

   26 union_head: UNION tag_identifier

   27 class_declaration: class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   28                  | class_head inheritance_opt LEFT_BRACE member_list RIGHT_BRACE
   29                  | class_head LEFT_PAREN error RIGHT_PAREN LEFT_BRACE member_list RIGHT_BRACE SEMICOLON

   30 inheritance_opt: /* empty */
   31                | COLON access_specifier_opt base_class_list

   32 access_specifier_opt: /* empty */
   33                     | access_specifier

   34 access_specifier: PUBLIC
   35                 | PRIVATE
   36                 | PROTECTED

   37 base_class_list: qualified_name
   38                | TYPE_NAME
   39                | base_class_list COMMA access_specifier_opt qualified_name

   40 member_list: /* empty */
   41            | member_list member_declaration

   42 member_declaration: access_specifier COLON
   43                   | function_definition
   44                   | function_declaration
   45                   | declaration
   46                   | typedef_declaration
   47                   | class_declaration
   48                   | enum_declaration
   49                   | union_declaration
   50                   | constructor_definition
   51                   | constructor_declaration
   52                   | destructor_definition
   53                   | destructor_declaration
   54                   | malformed_function_definition

   55 constructor_definition: IDENTIFIER LEFT_PAREN parameter_list_opt RIGHT_PAREN compound_statement

   56 constructor_declaration: IDENTIFIER LEFT_PAREN parameter_list_opt RIGHT_PAREN SEMICOLON

   57 destructor_definition: BITNOT IDENTIFIER LEFT_PAREN RIGHT_PAREN compound_statement

   58 destructor_declaration: BITNOT IDENTIFIER LEFT_PAREN RIGHT_PAREN SEMICOLON

   59 union_declaration: union_head LEFT_BRACE member_list RIGHT_BRACE SEMICOLON
   60                  | union_head LEFT_BRACE member_list RIGHT_BRACE

   61 enum_declaration: enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE SEMICOLON
   62                 | enum_head LEFT_BRACE enumerator_list_opt RIGHT_BRACE

   63 enumerator_list_opt: /* empty */
   64                    | enumerator_list

   65 enumerator_list: named_identifier
   66                | named_identifier ASSIGN constant_expression
   67                | enumerator_list COMMA named_identifier
   68                | enumerator_list COMMA named_identifier ASSIGN constant_expression

   69 function_definition: declaration_specifiers function_declarator compound_statement

   70 malformed_function_definition: declaration_specifiers declarator compound_statement

   71 declaration: declaration_specifiers SEMICOLON
   72            | declaration_specifiers init_declarator_list SEMICOLON
   73            | declaration_specifiers init_declarator_list missing_declaration_chain SEMICOLON
   74            | declaration_specifiers init_declarator_list error SEMICOLON
   75            | declaration_specifiers init_declarator_list error INVALID_TOKEN

   76 missing_declaration_chain: declaration_specifiers init_declarator_list
   77                          | missing_declaration_chain declaration_specifiers init_declarator_list

   78 function_declaration: declaration_specifiers function_declarator SEMICOLON

   79 typedef_declaration: TYPEDEF declaration_specifiers typedef_declarator_list SEMICOLON

   80 typedef_declarator_list: typedef_declarator
   81                        | typedef_declarator_list COMMA typedef_declarator

   82 typedef_declarator: declarator
   83                   | declarator ASSIGN initializer

   84 declaration_specifiers: declaration_prefix_opt type_specifier type_suffixes

   85 declaration_prefix_opt: /* empty */
   86                       | declaration_prefix_opt declaration_prefix

   87 declaration_prefix: type_qualifier
   88                   | storage_class_specifier
   89                   | function_specifier
   90                   | constexpr_specifier

   91 type_suffixes: /* empty */
   92              | type_suffixes type_suffix

   93 type_suffix: SHORT
   94            | LONG
   95            | LONG_LONG
   96            | SIGNED
   97            | UNSIGNED
   98            | CONST
   99            | VOLATILE

  100 storage_class_specifier: STATIC
  101                        | EXTERN
  102                        | REGISTER
  103                        | FRIEND

  104 function_specifier: INLINE

  105 constexpr_specifier: CONSTEXPR

  106 type_qualifier: CONST
  107               | VOLATILE

  108 type_specifier: VOID
  109               | CHAR
  110               | INT
  111               | FLOAT
  112               | DOUBLE
  113               | BOOL
  114               | AUTO
  115               | SHORT
  116               | LONG
  117               | LONG_LONG
  118               | SIGNED
  119               | UNSIGNED
  120               | TYPE_NAME
  121               | struct_specifier
  122               | ENUM tag_identifier
  123               | UNION tag_identifier
  124               | TYPENAME qualified_name

  125 struct_specifier: STRUCT tag_identifier struct_body_opt
  126                 | STRUCT LEFT_BRACE member_list RIGHT_BRACE

  127 struct_body_opt: /* empty */
  128                | LEFT_BRACE member_list RIGHT_BRACE

  129 init_declarator_list: init_declarator
  130                     | init_declarator_list COMMA init_declarator

  131 init_declarator: declarator
  132                | declarator ASSIGN initializer
  133                | declarator LEFT_PAREN argument_expression_list_opt RIGHT_PAREN

  134 initializer: assignment_expression
  135            | LEFT_BRACE initializer_list_opt RIGHT_BRACE

  136 initializer_list_opt: /* empty */
  137                     | initializer_list

  138 initializer_list: initializer
  139                 | initializer_list COMMA initializer
  140                 | initializer_list COMMA

  141 declarator: pointer_opt reference_opt direct_declarator
  142           | function_pointer_declarator

  143 reference_opt: /* empty */
  144              | reference

  145 reference: BITAND
  146          | ANDAND

  147 pointer_opt: /* empty */
  148            | pointer

  149 pointer: STAR pointer_after_star

  150 pointer_after_star: /* empty */
  151                   | pointer
  152                   | type_qualifier_list pointer_after_star

  153 type_qualifier_list: type_qualifier

  154 direct_declarator: qualified_name
  155                  | OPERATOR overload_operator
  156                  | LEFT_PAREN declarator RIGHT_PAREN
  157                  | direct_declarator LEFT_BRACKET constant_expression_opt RIGHT_BRACKET

  158 function_pointer_declarator: LEFT_PAREN pointer named_identifier RIGHT_PAREN LEFT_PAREN parameter_list_opt RIGHT_PAREN

  159 constant_expression_opt: /* empty */
  160                        | constant_expression

  161 function_declarator: pointer_opt reference_opt function_direct_declarator function_cv_qualifier_seq_opt

  162 function_cv_qualifier_seq_opt: /* empty */
  163                              | function_cv_qualifier_seq_opt type_qualifier

  164 function_direct_declarator: named_identifier LEFT_PAREN parameter_list_opt RIGHT_PAREN
  165                           | qualified_name LEFT_PAREN parameter_list_opt RIGHT_PAREN
  166                           | OPERATOR overload_operator LEFT_PAREN parameter_list_opt RIGHT_PAREN
  167                           | LEFT_PAREN function_declarator RIGHT_PAREN LEFT_PAREN parameter_list_opt RIGHT_PAREN

  168 overload_operator: PLUS
  169                  | MINUS
  170                  | STAR
  171                  | SLASH
  172                  | PERCENT
  173                  | ASSIGN
  174                  | EQ
  175                  | LT
  176                  | GT
  177                  | LEFT_BRACKET RIGHT_BRACKET
  178                  | LEFT_PAREN RIGHT_PAREN

  179 parameter_list_opt: /* empty */
  180                   | parameter_list

  181 parameter_list: parameter_declaration
  182               | parameter_list COMMA parameter_declaration
  183               | parameter_list COMMA ELLIPSIS
  184               | ELLIPSIS

  185 parameter_declaration: declaration_specifiers parameter_declarator default_argument_opt
  186                      | declaration_specifiers default_argument_opt

  187 parameter_declarator: declarator

  188 default_argument_opt: /* empty */
  189                     | ASSIGN initializer

  190 compound_statement: LEFT_BRACE block_item_list_opt RIGHT_BRACE

  191 block_item_list_opt: /* empty */
  192                    | block_item_list

  193 block_item_list: block_item
  194                | block_item_list block_item

  195 block_item: statement
  196           | declaration
  197           | typedef_declaration

  198 statement: compound_statement
  199          | expression_statement
  200          | selection_statement
  201          | iteration_statement
  202          | jump_statement
  203          | labeled_statement
  204          | error SEMICOLON

  205 expression_statement: expression_opt SEMICOLON

  206 selection_statement: IF LEFT_PAREN expression RIGHT_PAREN statement
  207                    | IF LEFT_PAREN expression RIGHT_PAREN statement ELSE statement
  208                    | SWITCH LEFT_PAREN expression RIGHT_PAREN statement
  209                    | IF LEFT_PAREN malformed_condition statement
  210                    | IF LEFT_PAREN malformed_condition statement ELSE statement
  211                    | SWITCH LEFT_PAREN malformed_condition statement

  212 malformed_condition: error RIGHT_PAREN

  213 iteration_statement: WHILE LEFT_PAREN expression RIGHT_PAREN statement
  214                    | UNTIL LEFT_PAREN expression RIGHT_PAREN statement
  215                    | DO statement WHILE LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  216                    | DO statement UNTIL LEFT_PAREN expression RIGHT_PAREN SEMICOLON
  217                    | FOR LEFT_PAREN for_init_opt SEMICOLON expression_opt SEMICOLON expression_opt RIGHT_PAREN statement
  218                    | WHILE LEFT_PAREN malformed_condition statement
  219                    | UNTIL LEFT_PAREN malformed_condition statement

  220 for_init_opt: /* empty */
  221             | expression
  222             | declaration_specifiers init_declarator_list

  223 jump_statement: GOTO named_identifier SEMICOLON
  224               | CONTINUE SEMICOLON
  225               | BREAK SEMICOLON
  226               | RETURN expression_opt SEMICOLON

  227 labeled_statement: named_identifier COLON statement
  228                  | CASE constant_expression COLON statement
  229                  | DEFAULT COLON statement

  230 expression_opt: /* empty */
  231               | expression

  232 expression: assignment_expression
  233           | expression COMMA assignment_expression

  234 assignment_expression: conditional_expression
  235                      | logical_or_expression assignment_operator assignment_expression

  236 assignment_operator: ASSIGN
  237                    | ADD_ASSIGN
  238                    | SUB_ASSIGN
  239                    | MUL_ASSIGN
  240                    | DIV_ASSIGN
  241                    | MOD_ASSIGN
  242                    | AND_ASSIGN
  243                    | OR_ASSIGN
  244                    | XOR_ASSIGN
  245                    | SHL_ASSIGN
  246                    | SHR_ASSIGN

  247 conditional_expression: logical_or_expression
  248                       | logical_or_expression QUESTION_MARK expression COLON conditional_expression

  249 constant_expression: conditional_expression

  250 logical_or_expression: logical_and_expression
  251                      | logical_or_expression OROR logical_and_expression

  252 logical_and_expression: inclusive_or_expression
  253                       | logical_and_expression ANDAND inclusive_or_expression

  254 inclusive_or_expression: exclusive_or_expression
  255                        | inclusive_or_expression BITOR exclusive_or_expression

  256 exclusive_or_expression: and_expression
  257                        | exclusive_or_expression BITXOR and_expression

  258 and_expression: equality_expression
  259               | and_expression BITAND equality_expression

  260 equality_expression: relational_expression
  261                    | equality_expression EQ relational_expression
  262                    | equality_expression NE relational_expression

  263 relational_expression: shift_expression
  264                      | relational_expression LT shift_expression
  265                      | relational_expression GT shift_expression
  266                      | relational_expression LE shift_expression
  267                      | relational_expression GE shift_expression

  268 shift_expression: additive_expression
  269                 | shift_expression SHL additive_expression
  270                 | shift_expression SHR additive_expression

  271 additive_expression: multiplicative_expression
  272                    | additive_expression PLUS multiplicative_expression
  273                    | additive_expression MINUS multiplicative_expression

  274 multiplicative_expression: cast_expression
  275                          | multiplicative_expression STAR cast_expression
  276                          | multiplicative_expression SLASH cast_expression
  277                          | multiplicative_expression PERCENT cast_expression

  278 cast_expression: unary_expression
  279                | LEFT_PAREN type_id RIGHT_PAREN cast_expression

  280 type_id: declaration_specifiers pointer_opt

  281 unary_expression: postfix_expression
  282                 | INC unary_expression
  283                 | DEC unary_expression
  284                 | BITAND cast_expression
  285                 | STAR cast_expression
  286                 | PLUS cast_expression
  287                 | MINUS cast_expression
  288                 | NOT cast_expression
  289                 | BITNOT cast_expression
  290                 | SIZEOF unary_expression
  291                 | SIZEOF LEFT_PAREN type_id RIGHT_PAREN
  292                 | NEW type_id
  293                 | NEW type_id LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  294                 | NEW type_id LEFT_BRACKET expression RIGHT_BRACKET
  295                 | NEW type_id LEFT_BRACKET RIGHT_BRACKET
  296                 | DELETE cast_expression
  297                 | DELETE LEFT_BRACKET RIGHT_BRACKET cast_expression

  298 postfix_expression: primary_expression
  299                   | postfix_expression LEFT_BRACKET expression RIGHT_BRACKET
  300                   | postfix_expression LEFT_PAREN argument_expression_list_opt RIGHT_PAREN
  301                   | postfix_expression DOT named_identifier
  302                   | postfix_expression ARROW named_identifier
  303                   | postfix_expression INC
  304                   | postfix_expression DEC

  305 argument_expression_list_opt: /* empty */
  306                             | argument_expression_list

  307 argument_expression_list: assignment_expression
  308                         | argument_expression_list COMMA assignment_expression

  309 primary_expression: IDENTIFIER
  310                   | IDENTIFIER SCOPE named_identifier
  311                   | INTEGER_LITERAL
  312                   | FLOAT_LITERAL
  313                   | EXPONENT_NUMBER_LITERAL
  314                   | HEXADECIMAL_LITERAL
  315                   | BINARY_LITERAL
  316                   | BOOLEAN_LITERAL
  317                   | STRING_LITERAL
  318                   | CHAR_LITERAL
  319                   | NULLPTR
  320                   | THIS
  321                   | PRINTF_FUNCTION
  322                   | SCANF_FUNCTION
  323                   | MALLOC_FUNCTION
  324                   | CALLOC_FUNCTION
  325                   | REALLOC_FUNCTION
  326                   | FREE_FUNCTION
  327                   | LEFT_PAREN expression RIGHT_PAREN
  328                   | lambda_expression

  329 lambda_expression: LEFT_BRACKET capture_list_opt RIGHT_BRACKET LEFT_PAREN parameter_list_opt RIGHT_PAREN lambda_return_opt compound_statement

  330 capture_list_opt: /* empty */
  331                 | capture_list

  332 capture_list: capture_item
  333             | capture_list COMMA capture_item

  334 capture_item: named_identifier
  335             | BITAND named_identifier
  336             | ASSIGN
  337             | BITAND

  338 lambda_return_opt: /* empty */
  339                  | ARROW type_id

  340 qualified_name: named_identifier
  341               | qualified_name SCOPE named_identifier

  342 named_identifier: IDENTIFIER

  343 tag_identifier: IDENTIFIER
  344               | TYPE_NAME


